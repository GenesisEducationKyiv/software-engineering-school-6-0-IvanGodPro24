{
  "name": "github-release-notification-api",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "description": "API for subscribing to GitHub repository release notifications via email",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run db:generate && npm run build-docs && tsc",
    "build:packages": "npm run build -w @github-notifier/shared -w @github-notifier/notification-contracts -w @github-notifier/scanner-contracts",
    "build:notification-service": "npm run build -w notification-service",
    "build:github-scanner-service": "npm run db:generate:scanner && npm run build -w github-scanner-service",
    "build:all": "npm run build:packages && npm run build && npm run build:notification-service && npm run build:github-scanner-service",
    "lint": "eslint .",
    "start": "node dist/src/index.js",
    "start:prod": "npm run db:migrate && node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test:notification-service": "npm run test:unit -w notification-service",
    "test:github-scanner-service": "npm run test:unit -w github-scanner-service",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=\\.integration\\.test\\.ts services/notification-service",
    "test:integration:run": "node --experimental-vm-modules node_modules/.bin/jest \\.integration\\.test\\.ts --detectOpenHandles",
    "test:integration": "./scripts/run-integration.sh",
    "test:e2e": "./scripts/run-e2e.sh",
    "test": "npm run test:notification-service && npm run test:github-scanner-service && npm run test:unit && npm run test:integration && npm run test:e2e",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:generate:scanner": "prisma generate --config services/github-scanner-service/prisma.config.ts",
    "db:migrate:scanner": "prisma migrate deploy --config services/github-scanner-service/prisma.config.ts",
    "db:migrate:dev:scanner": "prisma migrate dev --config services/github-scanner-service/prisma.config.ts",
    "predev": "npm run build-docs",
    "build-docs": "redocly bundle docs/openapi.yaml --ext json -o docs/swagger.json",
    "preview-docs": "redocly preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanGodPro24/github-release-notification-api.git"
  },
  "keywords": [],
  "author": "Ivan Nepotachev <vanyanep@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IvanGodPro24/github-release-notification-api/issues"
  },
  "homepage": "https://github.com/IvanGodPro24/github-release-notification-api#readme",
  "dependencies": {
    "@github-notifier/notification-contracts": "1.0.0",
    "@github-notifier/shared": "1.0.0",
    "@github-notifier/scanner-contracts": "1.0.0",
    "@bull-board/api": "^6.21.0",
    "@bull-board/express": "^6.21.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.14.0",
    "bullmq": "^5.73.4",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "http-errors": "^2.0.1",
    "ioredis": "5.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@redocly/cli": "^2.26.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
