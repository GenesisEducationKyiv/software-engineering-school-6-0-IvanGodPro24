{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/**/*.ts", "services/**/*.ts", "packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/__tests__/**",
    "**/generated/**",
    "coverage"
  ]
}
